# Local server. Existing shell environment variables take precedence.
PORT=8080
EVERLORE_SEED=0

# Optional: use Turso instead of the local everlore.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email links require a publicly reachable HTTPS origin.
EVERLORE_BASE_URL=
RESEND_API_KEY=
EVERLORE_EMAIL_FROM=

# Alternative to Resend: SMTP with STARTTLS.
EVERLORE_SMTP_ADDR=
EVERLORE_SMTP_FROM=
EVERLORE_SMTP_USER=
EVERLORE_SMTP_PASSWORD=

# Set to 1 only when the browser accesses the app over HTTPS.
EVERLORE_SECURE_COOKIES=0
